NODE_ENV=development
PORT=3000

# Local database. Two supported profiles - keep exactly one DATABASE_URL active.
#
# Docker parity profile (default here, and what `docker compose up -d` provisions
# in compose.yaml: user pawsh, database pawsh, host port 55432). These credentials
# are local-development-only and must never be reused for any deployed environment.
DATABASE_URL=postgres://pawsh:pawsh-local-only@127.0.0.1:55432/pawsh?options=-c%20TimeZone%3DUTC
#
# Native PostgreSQL 17 profile - see docs/development/local-database.md for the
# role/database SQL. Substitute the local-only password you chose there.
#DATABASE_URL=postgres://pawsh_local:replace-local-password@127.0.0.1:5432/pawsh_dev?options=-c%20TimeZone%3DUTC

SESSION_SECRET=replace-with-at-least-32-random-characters
APP_ORIGIN=http://127.0.0.1:3000
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
DOCUMENT_STORAGE_ADAPTER=filesystem
DOCUMENT_STORAGE_PATH=.pawsh-documents
DOCUMENT_STORAGE_BUCKET=
DOCUMENT_STORAGE_REGION=
DOCUMENT_STORAGE_ENDPOINT=
DOCUMENT_STORAGE_ACCESS_KEY_ID=
DOCUMENT_STORAGE_SECRET_ACCESS_KEY=
DOCUMENT_SCANNER_ADAPTER=http
DOCUMENT_SCANNER_ENDPOINT=http://127.0.0.1:4319/scan
DOCUMENT_SCANNER_TOKEN=

# Third-party credentials at rest. Raw 32-byte keys, base64, as `<version>:<key>` entries;
# several may be resident at once so a rotation can open what the old key sealed while new
# values are sealed under the active one. Its own key, never SESSION_SECRET or anything derived
# from it - the server refuses a keyring that is. Required in production; without it the Square
# integration is simply unavailable.
#   node -e "console.log('1:' + require('node:crypto').randomBytes(32).toString('base64'))"
PAWSH_INTEGRATION_ENCRYPTION_KEYS=
PAWSH_INTEGRATION_ENCRYPTION_KEY_ACTIVE=

# Square Terminal. All five together or none at all: a half-configured integration offers a
# connect button that reaches Square and a webhook receiver that cannot verify what comes back.
# No Square credentials exist for this project yet, so unconfigured is the normal local state and
# the routes report it honestly rather than pretending to be disconnected.
#
# PAWSH_SQUARE_NOTIFICATION_URL must be the EXACT subscription URL registered with Square, with
# no query or fragment. Square signs `notificationUrl + rawRequestBody`, so a value that differs
# by a scheme, a case or a trailing slash fails every signature check.
PAWSH_SQUARE_APPLICATION_ID=
PAWSH_SQUARE_APPLICATION_SECRET=
PAWSH_SQUARE_ENVIRONMENT=
PAWSH_SQUARE_NOTIFICATION_URL=
PAWSH_SQUARE_WEBHOOK_SIGNATURE_KEY=

.githooks/* text eol=lf
*.sh text eol=lf

# Square fixtures are signed byte-for-byte at test time. Any end-of-line translation would
# change the bytes the HMAC is computed over and the sha256 recorded in the manifest, so these
# files are checked out exactly as they are stored.
tests/fixtures/square/** -text

# The client is served as plain files and several tests/ui suites slice `public/app.js` by exact
# newline-plus-comment-opener sequences. A CRLF checkout (Windows, `core.autocrlf=true`) breaks
# every one of those slices with "public/app.js no longer contains ...", which is exactly what the
# Windows runners in the compatibility matrix reported. These files are stored LF and are checked
# out LF everywhere, so the tests read the bytes the repository holds.
public/*.js text eol=lf
public/*.css text eol=lf
public/*.html text eol=lf

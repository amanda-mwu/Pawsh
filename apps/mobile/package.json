{
  "name": "@pawsh/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "prebuild": "expo prebuild",
    "build:domain": "npm --prefix ../.. run build:packages",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "export:ios": "expo export --platform ios --output-dir .expo-export-ios",
    "export:android": "expo export --platform android --output-dir .expo-export-android",
    "validate": "npm run typecheck && npm test && npm run export:ios && npm run export:android"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@pawsh/domain": "file:../../packages/domain",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@tanstack/react-query": "^5.102.6",
    "expo": "^57.0.16",
    "expo-clipboard": "~57.0.1",
    "expo-constants": "~57.0.14",
    "expo-dev-client": "~57.0.16",
    "expo-haptics": "~57.0.1",
    "expo-linking": "~57.0.7",
    "expo-router": "~57.0.16",
    "expo-secure-store": "~57.0.1",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.4",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.4",
    "typescript": "~6.0.3"
  }
}

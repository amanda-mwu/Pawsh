{
  "name": "pawsh",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "packageManager": "npm@11.6.0",
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "check:runtime": "node scripts/check-runtime.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:db": "vitest run tests/database",
    "test:e2e": "playwright test",
    "test:smoke": "playwright test --project=chromium-desktop --grep @smoke",
    "test:cross-browser": "playwright test --grep @cross-browser",
    "test:watch": "vitest",
    "seed:qa": "node --env-file-if-exists=.env --import tsx scripts/seed-qa.ts",
    "start:e2e": "node --env-file-if-exists=.env --import tsx src/server.ts",
    "db:migrate": "node --env-file-if-exists=.env --import tsx scripts/migrate.ts",
    "db:verify-restore": "node --import tsx scripts/verify-restored-db.ts",
    "validate": "npm run check:runtime && npm run lint && npm run typecheck && npm test && npm run build",
    "validate:runtime": "npm run db:migrate && npm run test:db",
    "validate:ci": "npm run db:migrate && npm run validate && npm run test:db",
    "validate:qa": "npm run validate:ci && npm run test:smoke",
    "hooks:install": "node scripts/install-hooks.mjs",
    "prepare": "node scripts/install-hooks.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.1.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^10.1.2",
    "@node-rs/argon2": "^2.0.2",
    "fastify": "^5.6.2",
    "nodemailer": "^9.0.3",
    "postgres": "^3.4.7",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@playwright/test": "^1.62.0",
    "@types/node": "^24.10.0",
    "@types/nodemailer": "^8.0.1",
    "eslint": "^9.38.0",
    "html-validate": "^11.6.0",
    "pgsql-parser": "^18.1.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "vitest": "^4.0.4"
  }
}
